   "source": [
    "notas = {\"Ane\": 7, \"Jon\": 4, \"Leire\": 9, \"Mikel\": 5}\n",
    "\n",
    "def media(d):\n",
    "    total = 0\n",
    "    for x in d.values():\n",
    "        total += x\n",
    "    return total/len(d)\n",
    "\n",
    "print(media(notas))\n",
    "\n",
    "\n",
    "aprobaos = [aprobao for aprobao, nota in notas.items() if nota>=5]\n",
    "\n",
    "print(aprobaos)"
   ]
